{
  "expo": {
    "name": "ArrowZing",
    "slug": "outbound",
    "scheme": "outbound",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "backgroundColor": "#FFF7E8",
    "android": {
      "package": "com.yourstudio.outbound",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "splash": {
        "backgroundColor": "#FFF7E8",
        "dark": {
          "backgroundColor": "#1F1C18"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
