{
  "name": "outbound",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:doctor": "bun scripts/checkAndroidEnv.ts",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:apk": "android/gradlew.bat -p android assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "android:apk:debug": "android/gradlew.bat -p android assembleDebug",
    "android:aab": "android/gradlew.bat -p android bundleRelease",
    "android:release:device": "expo run:android --variant release",
    "android:clean": "bun scripts/cleanAndroid.ts",
    "eas:preview": "bunx eas-cli build --platform android --profile preview",
    "eas:production": "bunx eas-cli build --platform android --profile production",
    "test": "bun test",
    "validate-levels": "bun scripts/validateLevels.ts",
    "analyze-levels": "bun scripts/analyzeLevels.ts",
    "generate-levels": "bun scripts/generateLevels.ts",
    "generate-sounds": "bun scripts/generateSounds.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "bunx expo-doctor",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
